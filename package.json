    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "openai": "^6.49.0",
    "playwright": "^1.64.1",
    "sharp": "^0.34.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
