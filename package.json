{
  "name": "matchpic",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "MatchPic — one creative to every placement size, with Meta's models (Meta hackathon)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "render:adfit-fixtures": "tsx scripts/render-adfit-fixtures.ts",
    "adfit:live": "tsx scripts/adfit-live.ts",
    "ui-shots": "tsx scripts/ui-shots.ts",
    "build:web": "tsx scripts/build-web.ts",
    "web": "npm run build:web && tsx src/server/http/server.ts",
    "web:dev": "tsx scripts/build-web.ts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "buildlog:save": "bash scripts/save-build-log.sh"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@meta-sam/parser": "^0.1.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "hono": "^4.13.14",
    "openai": "^6.49.0",
    "playwright": "^1.64.1",
    "sharp": "^0.34.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
