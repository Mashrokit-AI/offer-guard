{
  "name": "offer-guard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Offer Guard — verify ad promises against the approved offer (Meta hackathon)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "probe:meta": "tsx scripts/probe-meta-write.ts",
    "cleanup:probe": "tsx scripts/cleanup-probe.ts",
    "killtest:spark": "tsx scripts/killtest-spark.ts",
    "killtest:sam": "tsx scripts/killtest-sam.ts",
    "killtest:repair": "tsx scripts/killtest-repair.ts",
    "render:fixtures": "tsx scripts/render-fixtures.ts",
    "sweep": "tsx scripts/sweep.ts",
