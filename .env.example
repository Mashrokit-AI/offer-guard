# Offer Guard — copy to .env and fill in. Never commit .env (it is gitignored).
# META_ACCESS_TOKEN and MODEL_API_KEY go in ~/.config/offer-guard/secrets.env (outside the repo), not here
META_GRAPH_VERSION=v25.0
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_ADSET_ID=
META_TEST_LINK_URL=
MODEL_API_BASE=https://api.meta.ai/v1
# Landing-page capture: comma-separated host allowlist (default: 127.0.0.1).
# The sweep's local static server is always 127.0.0.1 — keep it listed.
OFFER_GUARD_ALLOWED_HOSTS=127.0.0.1
# Base URL for landing pages in the campaign manifest ({PAGES_BASE} template).
# Unset = the sweep serves fixtures/pages/ itself on 127.0.0.1.
OFFER_GUARD_PAGES_BASE=
# Web app (npm run web). No secrets here.
OFFER_GUARD_PORT=3023
OFFER_GUARD_BASE_PATH=/
# Kill switch for live model work: off = fresh runs and own-ad checks are
# refused with a friendly message; saved results keep working.
OFFER_GUARD_LIVE=on
# Trust X-Forwarded-For for rate limiting (set 1 only behind our own nginx).
OFFER_GUARD_TRUST_PROXY=0
OFFER_GUARD_DAILY_MODEL_CALLS=300
