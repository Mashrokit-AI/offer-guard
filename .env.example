# MatchPic — copy to .env and fill in. Never commit .env (it is gitignored).
# MODEL_API_KEY goes in ~/.config/offer-guard/secrets.env (outside the repo), not here.
# (Historical path, kept so existing setups keep working after the MatchPic pivot.)
MODEL_API_BASE=https://api.meta.ai/v1
# Web app (npm run web). No secrets here.
ADFIT_PORT=3023
ADFIT_BASE_PATH=/
# Kill switch for live model work: off = generation and template parsing are
# refused with a friendly message; saved results keep working.
ADFIT_LIVE=on
# Trust X-Forwarded-For for rate limiting (set 1 only behind our own nginx).
ADFIT_TRUST_PROXY=0
ADFIT_DAILY_MODEL_CALLS=300
ADFIT_DAILY_IMAGES=200
